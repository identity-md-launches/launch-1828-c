# CardVault site configuration. Every value is optional: the defaults are the verified Sepolia
# deployment (deployment.json, source commit ef5a93b). Override to repoint the site.
VITE_CHAIN_ID=11155111
# Comma-separated public RPCs, tried in order.
VITE_RPC_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://rpc.sepolia.ethpandaops.io,https://sepolia.rpc.sentio.xyz
# Block the contracts were deployed in; event scans start here.
VITE_FROM_BLOCK=11920137
VITE_MOCK_USDC=0x79d4f28dbcd48836f80fe3e851419e67c6ce639a
VITE_MOCK_CARD_NFT=0x4d1dd1082e3841dc9b6f900252a15b5ef11ec4ac
VITE_CARD_POOL=0x225e41fed68048d95a0c5f7d3a04f792c23cf585
VITE_CARD_ORACLE=0xa981bb206daf2ceb22b879ed6c62519f37332756
VITE_CARD_LENDING=0xecd0992da58c974f4fa882b2ec8bde44d3bce7db
# Optional: your own WalletConnect Cloud project id adds a "WalletConnect" row to the connect sheet.
VITE_WALLETCONNECT_PROJECT_ID=
